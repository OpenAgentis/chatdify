# Environment-variable form of examples/config.toml; environment variables override config.toml.
# Copy to a file outside version control (e.g. env.sh, which is gitignored), fill in the <...>
# values, then `source env.sh`.

# export CHATDIFY_HOME=./output/run_home   # keep config, logs and caches per project (default ~/.chatdify)
export CHATDIFY_LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
export CHATDIFY_LLM_MODEL=GLM-5.3-Flash
export CHATDIFY_LLM_API_KEY='<your-llm-api-key>'
export CHATDIFY_LLM_EXTRA_BODY='{"thinking": {"type": "enabled"}}'

export CHATDIFY_DIFY_STATIC_VALIDATION=true
export CHATDIFY_DIFY_URL=http://localhost
export CHATDIFY_DIFY_EMAIL='<your-dify-email>'
export CHATDIFY_DIFY_PASSWORD='<your-dify-password>'
export CHATDIFY_DIFY_DYNAMIC_VALIDATION=true

# Models used by the generated workflow's nodes; must exist in your Dify workspace.
export CHATDIFY_WORKFLOW_LLM='{"provider": "langgenius/deepseek/deepseek", "name": "deepseek-v4-flash"}'
# export CHATDIFY_WORKFLOW_VISION_LLM='{"name": "<a-vision-model-in-your-dify>"}'
export CHATDIFY_WORKFLOW_RERANK='{"provider": "langgenius/siliconflow/siliconflow", "model": "BAAI/bge-reranker-v2-m3"}'
export CHATDIFY_WORKFLOW_EMBEDDING='{"provider": "langgenius/siliconflow/siliconflow", "model": "BAAI/bge-m3"}'
